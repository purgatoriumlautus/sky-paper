# swayidle — laniakea idle pipeline.
# Spawned by niri (`spawn-at-startup "swayidle" "-w"`).
# One config for AC and battery (deliberate — see README.md / spec).
#
# Flow: 5m dim → 10m lock+screen-off (together) → 30m suspend.
# CC "Auto-suspend" toggle blocks the 30m step via systemd-inhibit.
#
# NOTE: swayidle has no `\` line continuation — each directive must be
# on one physical line (verified: backslash → wordexp syntax error).

# 5m — soft dim. Saves brightness so resume restores it exactly.
timeout 300 'brightnessctl --save && brightnessctl set 50%-' resume 'brightnessctl --restore'

# 10m — lock first (Quickshell paint), then DPMS off in the same step.
# Resume turns the monitor back on; the lock stays — user sees the lock.
timeout 600 'qs ipc call lock lock; niri msg action power-off-monitors' resume 'niri msg action power-on-monitors'

# 30m — suspend. No resume hook: logind/swayidle re-init on wake.
# Nothing is gated here: the CC "Auto-suspend" toggle works by holding a
# Wayland idle inhibitor (Bar.qml), so when it's off this whole file's timeline
# never advances and every step above is paused too.
timeout 1800 'systemctl suspend'

# Lock BEFORE any suspend (idle, lid, manual) so wake shows the lock
# screen with no flash of the desktop.
before-sleep 'qs ipc call lock lock'

# `loginctl lock-session` → Quickshell lock (via `qs ipc`).
lock 'qs ipc call lock lock'
