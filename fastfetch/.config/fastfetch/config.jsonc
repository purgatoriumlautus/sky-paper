// Flexoki Dark fastfetch — Aphex Twin λ logo, purple accent
// palette: bg #100F0F fg #CECDC3 accent #8B7EC8 muted #878580
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // swap "source" between lambdascii.txt (round braille λ) and ascii.txt (letter-M circle)
  "logo": {
    "source": "~/.config/fastfetch/lambdascii.txt",
    "type": "file",
    "color": { "1": "38;2;139;126;200" },
    "padding": { "top": 1, "right": 3 }
  },

  "display": {
    "separator": "  ",
    "key": { "width": 6 },
    "color": {
      "keys":   "38;2;139;126;200",
      "title":  "1;38;2;139;126;200",
      "output": "38;2;206;205;195"
    },
    "size":     { "binaryPrefix": "iec" },
    "temp":     { "unit": "C", "ndigits": 0 },
    "bar":      { "char": { "elapsed": "█", "total": "░" }, "width": 12 },
    "percent":  { "type": 2 }
  },

  "modules": [
    { "type": "title", "format": "{user-name-colored}@{host-name-colored}" },
    "separator",
    { "type": "os",        "key": "os" },
    { "type": "kernel",    "key": "kern" },
    { "type": "uptime",    "key": "up" },
    { "type": "packages",  "key": "pkgs" },
    { "type": "shell",     "key": "sh" },
    { "type": "wm",        "key": "wm" },
    { "type": "terminal",  "key": "term" },
    { "type": "cpu",       "key": "cpu" },
    { "type": "gpu",       "key": "gpu", "format": "{name}" },
    { "type": "memory",    "key": "mem" },
    { "type": "disk",      "key": "disk", "folders": "/" },
    { "type": "battery",   "key": "bat" },
    "break",
    { "type": "colors", "symbol": "block", "paddingLeft": 0 }
  ]
}
