# Flexoki Dark — see ~/celestia/PALETTE.md
# Two-tone bg (night paper + bg-alt) · purple accent · dark text on the accent.

# ── colors ──────────────────────────────────────────────────────────────
set default-bg              "#100F0F"
set default-fg              "#CECDC3"

set statusbar-bg            "#1C1B1A"
set statusbar-fg            "#878580"
set statusbar-h-padding     8
set statusbar-v-padding     2

set inputbar-bg             "#1C1B1A"
set inputbar-fg             "#CECDC3"

set notification-bg         "#8B7EC8"
set notification-fg         "#100F0F"
set notification-error-bg   "#D14D41"
set notification-error-fg   "#100F0F"
set notification-warning-bg "#D0A215"
set notification-warning-fg "#100F0F"

set completion-bg           "#1C1B1A"
set completion-fg           "#CECDC3"
set completion-group-bg     "#403E3C"
set completion-group-fg     "#CECDC3"
set completion-highlight-bg "#8B7EC8"
set completion-highlight-fg "#100F0F"

set index-bg                "#100F0F"
set index-fg                "#CECDC3"
set index-active-bg         "#8B7EC8"
set index-active-fg         "#100F0F"

# in-page search hits — accent for inactive, bright purple for current
set highlight-color         "#8B7EC8"
set highlight-active-color  "#A699D0"

# recolor mode (`Ctrl-r`) — dark reading mode that matches the native palette
set recolor                 "false"
set recolor-lightcolor      "#100F0F"
set recolor-darkcolor       "#CECDC3"
set recolor-keephue         "true"

# page bg behind PDFs (visible at zoom-out / fit-width gaps)
set render-loading          "true"
set render-loading-bg       "#1C1B1A"
set render-loading-fg       "#878580"

# ── font ────────────────────────────────────────────────────────────────
# Statusbar/inputbar — match kitty/bar. Terminess at 11 reads crisp at the
# native bitmap sizes (memory: reference-terminess-native-sizes).
set font                    "Terminess Nerd Font Mono 11"

# ── behavior ────────────────────────────────────────────────────────────
set adjust-open             "width"
set pages-per-row           1
set scroll-page-aware       "true"
set scroll-full-overlap     0.05
set scroll-step             80
set zoom-min                10

set selection-clipboard     "clipboard"
set sandbox                 "none"
set window-title-basename   "true"
set statusbar-basename      "true"
set guioptions              ""
