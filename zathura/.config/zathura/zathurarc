# Sky Paper — see ~/dotfiles/PALETTE.md
# Two-tone bg (cream + bg-alt) · single accent fill · deep-sky for highlights.

# ── colors ──────────────────────────────────────────────────────────────
set default-bg              "#F0EBE0"
set default-fg              "#1F1812"

set statusbar-bg            "#E4DED0"
set statusbar-fg            "#7A716A"
set statusbar-h-padding     8
set statusbar-v-padding     2

set inputbar-bg             "#E4DED0"
set inputbar-fg             "#1F1812"

set notification-bg         "#A8C0D5"
set notification-fg         "#1F1812"
set notification-error-bg   "#1F1812"
set notification-error-fg   "#F0EBE0"
set notification-warning-bg "#C5BFB5"
set notification-warning-fg "#1F1812"

set completion-bg           "#E4DED0"
set completion-fg           "#1F1812"
set completion-group-bg     "#C5BFB5"
set completion-group-fg     "#1F1812"
set completion-highlight-bg "#A8C0D5"
set completion-highlight-fg "#1F1812"

set index-bg                "#F0EBE0"
set index-fg                "#1F1812"
set index-active-bg         "#A8C0D5"
set index-active-fg         "#1F1812"

# in-page search hits — accent-soft for inactive, deep sky tint for current
set highlight-color         "#A8C0D5"
set highlight-active-color  "#4A6F8E"

# recolor mode (`Ctrl-r`) — invert-friendly for dark rooms but stay in palette
set recolor                 "false"
set recolor-lightcolor      "#F0EBE0"
set recolor-darkcolor       "#1F1812"
set recolor-keephue         "true"

# page bg behind PDFs (visible at zoom-out / fit-width gaps)
set render-loading          "true"
set render-loading-bg       "#E4DED0"
set render-loading-fg       "#7A716A"

# ── font ────────────────────────────────────────────────────────────────
# Statusbar/inputbar — match kitty/bar. Terminess at 11 reads crisp at the
# native bitmap sizes (memory: reference-terminess-native-sizes).
set font                    "Terminess Nerd Font Mono 11"

# ── behavior ────────────────────────────────────────────────────────────
set adjust-open             "width"
set pages-per-row           1
set scroll-page-aware       "true"
set scroll-full-overlap     0.05
set scroll-step             80
set zoom-min                10

set selection-clipboard     "clipboard"
set sandbox                 "none"
set window-title-basename   "true"
set statusbar-basename      "true"
set guioptions              ""
