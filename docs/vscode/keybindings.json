// VSCode keybindings for the work Mac — merge into
//   ~/Library/Application Support/Code/User/keybindings.json
//
// This is the Alt tier: identical keys to tmux + nvim on celestia, only the
// program executing them differs. Full scheme: docs/keybinds.md
//
// Needs "terminal.integrated.macOptionIsMeta": true in settings.json, and
// every command here listed in "commandsToSkipShell", or the keystroke gets
// typed into fish instead of acted on.
[
  // ══════════════════════════════════════════════════════════
  // Alt+t — THE central bind. Works from both sides of the
  // editor/terminal border, which is exactly why it needs a
  // modifier: inside the terminal a bare <Space>t would just be
  // typed as text.
  // ══════════════════════════════════════════════════════════
  { "key": "alt+t", "command": "workbench.action.terminal.toggleTerminal" },

  // ══════════════════════════════════════════════════════════
  // Alt+hjkl — focus. The terminal is always "down", same as
  // nvim + tmux at home.
  // ══════════════════════════════════════════════════════════
  { "key": "alt+j", "command": "workbench.action.terminal.focus",
    "when": "!terminalFocus" },
  { "key": "alt+k", "command": "workbench.action.focusActiveEditorGroup",
    "when": "terminalFocus" },
  { "key": "alt+h", "command": "workbench.action.focusLeftGroup" },
  { "key": "alt+l", "command": "workbench.action.focusRightGroup" },

  // Within the editor, up/down move between stacked groups
  { "key": "alt+k", "command": "workbench.action.focusAboveGroup",
    "when": "!terminalFocus && !sideBarFocus" },

  // From the sidebar (file tree) back into the code
  { "key": "alt+l", "command": "workbench.action.focusActiveEditorGroup",
    "when": "sideBarFocus" },

  // Alt+h has to mean two things, and which one depends on where you already
  // are. The tree sits to the left of the LEFTMOST editor group, so from that
  // group Alt+h is "go to the tree" — but from any group further right it has
  // to mean "go one group left", or split editors become unreachable in one
  // direction. tmux and nvim behave exactly this way: the key walks panes
  // until there is nothing left to walk to.
  //
  // A single unconditional rule cannot express that, because VSCode resolves
  // to the LAST matching rule rather than the most specific one — so an
  // "editorTextFocus → focusSideBar" line placed after "focusLeftGroup" wins
  // everywhere and swallows the left-group case entirely.
  //
  // activeEditorGroupIndex is 1-based and counts from the left, so index 1 IS
  // the leftmost group. The two clauses below are mutually exclusive, which is
  // what makes them safe to leave in either order.
  { "key": "alt+h", "command": "workbench.action.focusSideBar",
    "when": "editorTextFocus && activeEditorGroupIndex == 1" },
  { "key": "alt+h", "command": "workbench.action.focusLeftGroup",
    "when": "editorTextFocus && activeEditorGroupIndex != 1" },

  // From the terminal, Alt+h goes to the tree. That is not a special case, it
  // is the geometry: the sidebar spans the full height of the window, so it
  // really is what sits to the left of the terminal panel, exactly as it sits
  // to the left of the editor.
  //
  // Alt+l keeps walking terminal panes, and the asymmetry is deliberate:
  // there is nothing to the right of the panel, so the key would otherwise be
  // dead, while there IS something to the left. Panes stay reachable in both
  // directions through Alt+n / Alt+p, which walk every terminal instance —
  // split panes included.
  { "key": "alt+h", "command": "workbench.action.focusSideBar",
    "when": "terminalFocus" },
  { "key": "alt+l", "command": "workbench.action.terminal.focusNextPane",
    "when": "terminalFocus" },

  // ══════════════════════════════════════════════════════════
  // Alt+Shift+hjkl — resize
  // ══════════════════════════════════════════════════════════
  { "key": "alt+shift+h", "command": "workbench.action.decreaseViewSize" },
  { "key": "alt+shift+l", "command": "workbench.action.increaseViewSize" },
  { "key": "alt+shift+k", "command": "workbench.action.increaseViewSize" },
  { "key": "alt+shift+j", "command": "workbench.action.decreaseViewSize" },

  // ══════════════════════════════════════════════════════════
  // Alt+v / Alt+s / Alt+q — structure, from vim's own vocabulary
  // (<C-w>v, <C-w>s, :q)
  // ══════════════════════════════════════════════════════════
  // Whoever has focus is who splits — the same rule as celestia, where
  // tmux.conf routes Alt+v/Alt+s through an is_vim test and either forwards
  // the key into nvim or splits the pane itself.
  { "key": "alt+v", "command": "workbench.action.splitEditor",
    "when": "!terminalFocus" },
  { "key": "alt+s", "command": "workbench.action.splitEditorDown",
    "when": "!terminalFocus" },
  // VSCode has no directional terminal split: the direction follows the
  // panel's own orientation, so both keys land on the one command.
  { "key": "alt+v", "command": "workbench.action.terminal.split",
    "when": "terminalFocus" },
  { "key": "alt+s", "command": "workbench.action.terminal.split",
    "when": "terminalFocus" },
  { "key": "alt+q", "command": "workbench.action.closeActiveEditor",
    "when": "!terminalFocus" },
  { "key": "alt+q", "command": "workbench.action.terminal.kill",
    "when": "terminalFocus" },
  { "key": "alt+z", "command": "workbench.action.toggleMaximizedPanel",
    "when": "terminalFocus" },
  { "key": "alt+z", "command": "workbench.action.toggleEditorWidths",
    "when": "!terminalFocus" },

  // ══════════════════════════════════════════════════════════
  // Alt+digits / Alt+n / Alt+p — "window N", where what counts as a window
  // depends on which container has focus.
  //
  // In the terminal these select terminals; in the editor they select
  // editors. One key, one meaning — "go to the Nth thing in front of me" —
  // resolved by context rather than by remembering two separate keys.
  //
  // celestia reaches the same place from the other side: tmux binds M-1..9
  // and M-n/M-p in its ROOT table, so there a tmux window is always what
  // answers. VSCode has no tmux, so the editor half has to be spelled out.
  //
  // Editors also keep their own vim-native keys, unchanged:
  //   Shift+H / Shift+L   previous / next buffer
  //   <leader>1..9        editor N
  // ══════════════════════════════════════════════════════════
  { "key": "alt+1", "command": "workbench.action.terminal.focusAtIndex1",
    "when": "terminalFocus" },
  { "key": "alt+1", "command": "workbench.action.openEditorAtIndex1",
    "when": "!terminalFocus" },
  { "key": "alt+2", "command": "workbench.action.terminal.focusAtIndex2",
    "when": "terminalFocus" },
  { "key": "alt+2", "command": "workbench.action.openEditorAtIndex2",
    "when": "!terminalFocus" },
  { "key": "alt+3", "command": "workbench.action.terminal.focusAtIndex3",
    "when": "terminalFocus" },
  { "key": "alt+3", "command": "workbench.action.openEditorAtIndex3",
    "when": "!terminalFocus" },
  { "key": "alt+4", "command": "workbench.action.terminal.focusAtIndex4",
    "when": "terminalFocus" },
  { "key": "alt+4", "command": "workbench.action.openEditorAtIndex4",
    "when": "!terminalFocus" },
  { "key": "alt+5", "command": "workbench.action.terminal.focusAtIndex5",
    "when": "terminalFocus" },
  { "key": "alt+5", "command": "workbench.action.openEditorAtIndex5",
    "when": "!terminalFocus" },
  { "key": "alt+6", "command": "workbench.action.terminal.focusAtIndex6",
    "when": "terminalFocus" },
  { "key": "alt+6", "command": "workbench.action.openEditorAtIndex6",
    "when": "!terminalFocus" },
  { "key": "alt+7", "command": "workbench.action.terminal.focusAtIndex7",
    "when": "terminalFocus" },
  { "key": "alt+7", "command": "workbench.action.openEditorAtIndex7",
    "when": "!terminalFocus" },
  { "key": "alt+8", "command": "workbench.action.terminal.focusAtIndex8",
    "when": "terminalFocus" },
  { "key": "alt+8", "command": "workbench.action.openEditorAtIndex8",
    "when": "!terminalFocus" },
  { "key": "alt+9", "command": "workbench.action.terminal.focusAtIndex9",
    "when": "terminalFocus" },
  { "key": "alt+9", "command": "workbench.action.openEditorAtIndex9",
    "when": "!terminalFocus" },
  { "key": "alt+n", "command": "workbench.action.terminal.focusNext",
    "when": "terminalFocus" },
  { "key": "alt+p", "command": "workbench.action.terminal.focusPrevious",
    "when": "terminalFocus" },
  { "key": "alt+n", "command": "workbench.action.nextEditor",
    "when": "!terminalFocus" },
  { "key": "alt+p", "command": "workbench.action.previousEditor",
    "when": "!terminalFocus" },

  // ══════════════════════════════════════════════════════════
  // Alt+Space — both thumbs, the cheapest chord on the board,
  // given to the biggest action: go to a different project.
  // ══════════════════════════════════════════════════════════
  { "key": "alt+space",  "command": "workbench.action.openRecent" },
  { "key": "alt+enter",  "command": "workbench.action.terminal.new" },
  { "key": "alt+u",      "command": "workbench.action.terminal.focusFind",
    "when": "terminalFocus" },
  { "key": "alt+r",      "command": "workbench.action.reloadWindow" },

  // ══════════════════════════════════════════════════════════
  // Cmd tier — plain macOS. Mostly restating defaults, listed anyway so the
  // file is a complete statement of the scheme rather than a diff against
  // whatever Apple ships this year.
  //
  // Physically it lines up with celestia: after the Mac's Modifier Keys swap,
  // the 2nd key out from the space bar emits Command, and on the PC the 2nd
  // key out is Super. Same thumb travel, same result.
  //
  // celestia reaches the same place by a different road — there keyd rewrites
  // Super+C/V/X/A/Z into chords Linux programs already understand
  // (keyd/etc/keyd/default.conf), because Ctrl+C there is SIGINT and cannot be
  // reused. That translation is a Linux problem and stays in the Linux config;
  // nothing about it belongs in this file.
  //
  // Cmd+F and Cmd+W have no celestia counterpart: niri owns Mod+F (fullscreen)
  // and Mod+W. Find stays <leader>/ and vim's own /, identical on both.
  // ══════════════════════════════════════════════════════════
  { "key": "cmd+c", "command": "editor.action.clipboardCopyAction",  "when": "!terminalFocus" },
  { "key": "cmd+v", "command": "editor.action.clipboardPasteAction", "when": "!terminalFocus" },
  { "key": "cmd+x", "command": "editor.action.clipboardCutAction",   "when": "!terminalFocus" },
  // vim.handleKeys in settings.json gives <C-a> back to VSCode rather than
  // letting VSCodeVim treat it as increment; Cmd+A is unaffected either way.
  { "key": "cmd+a", "command": "editor.action.selectAll",            "when": "!terminalFocus" },
  { "key": "cmd+z", "command": "undo",                               "when": "!terminalFocus" },
  { "key": "cmd+shift+z", "command": "redo",                         "when": "!terminalFocus" },
  { "key": "cmd+s", "command": "workbench.action.files.save" },

  // Inside the terminal these copy/paste the SCREEN selection. That is a
  // different operation from fish's Ctrl+X, which copies the command-line
  // buffer and therefore brings no prompt, padding or right-prompt clock
  // with it. Both are kept on purpose; they are not redundant.
  { "key": "cmd+c", "command": "workbench.action.terminal.copySelection",
    "when": "terminalFocus && terminalTextSelected" },
  { "key": "cmd+v", "command": "workbench.action.terminal.paste",
    "when": "terminalFocus" },

  // ══════════════════════════════════════════════════════════
  // Ctrl+C in the terminal must always be SIGINT.
  //
  // VSCode ships a binding that makes Ctrl+C copy instead of interrupting
  // whenever text happens to be selected, so a stray selection silently turns
  // "kill this process" into "copy". A "-" entry deletes a default binding by
  // naming the exact command it is bound to; if this build does not ship that
  // default the line simply matches nothing.
  //
  // Ctrl+V is untouched: it is already claimed by the sendSequence block below
  // and goes to fish.
  // ══════════════════════════════════════════════════════════
  { "key": "ctrl+c", "command": "-workbench.action.terminal.copySelection" },

  // ══════════════════════════════════════════════════════════
  // Lists — this is what actually makes VSCode keyboard-driven.
  // File tree, search results, extension list: all list widgets,
  // and by default they only move with arrow keys.
  // "listFocus && !inputFocus" = focused on a list, not typing
  // in a text box — so bare letters are free.
  // ══════════════════════════════════════════════════════════
  { "key": "j", "command": "list.focusDown",
    "when": "listFocus && !inputFocus && !treestickyScrollFocused" },
  { "key": "k", "command": "list.focusUp",
    "when": "listFocus && !inputFocus && !treestickyScrollFocused" },
  { "key": "h", "command": "list.collapse",
    "when": "listFocus && !inputFocus" },
  { "key": "l", "command": "list.expand",
    "when": "listFocus && !inputFocus" },
  { "key": "g g", "command": "list.focusFirst",
    "when": "listFocus && !inputFocus" },
  { "key": "shift+g", "command": "list.focusLast",
    "when": "listFocus && !inputFocus" },
  { "key": "o", "command": "list.select",
    "when": "listFocus && !inputFocus" },
  { "key": "alt+v", "command": "explorer.openToSide",
    "when": "filesExplorerFocus && !inputFocus" },
  { "key": "escape", "command": "workbench.action.focusActiveEditorGroup",
    "when": "filesExplorerFocus && !inputFocus" },

  // ══════════════════════════════════════════════════════════
  // File operations in the tree — nvim-tree's default set, which
  // init.lua keeps by calling default_on_attach() before its own
  // overrides. Same letters, same meanings.
  //
  // One unavoidable split: nvim-tree's `a` makes a file or a directory
  // depending on a trailing "/", while VSCode has two separate commands.
  // So `a` is the file and `A` the folder.
  //
  // "!inputFocus" matters more here than anywhere else: the moment one of
  // these opens its name box, focus moves into a text input and every bare
  // letter must go back to being a letter.
  // ══════════════════════════════════════════════════════════
  { "key": "a", "command": "explorer.newFile",
    "when": "filesExplorerFocus && !inputFocus" },
  { "key": "shift+a", "command": "explorer.newFolder",
    "when": "filesExplorerFocus && !inputFocus" },
  { "key": "r", "command": "renameFile",
    "when": "filesExplorerFocus && !inputFocus" },
  { "key": "d", "command": "deleteFile",
    "when": "filesExplorerFocus && !inputFocus" },
  { "key": "shift+d", "command": "moveFileToTrash",
    "when": "filesExplorerFocus && !inputFocus" },
  // y / x / p — vim's own three letters, not nvim-tree's defaults. Upstream
  // puts copy-the-file on `c` and copy-the-NAME on `y`, which inverts what
  // yank means everywhere else in vim; init.lua now overrides it the same way.
  { "key": "y", "command": "filesExplorer.copy",
    "when": "filesExplorerFocus && !inputFocus" },
  { "key": "x", "command": "filesExplorer.cut",
    "when": "filesExplorerFocus && !inputFocus" },
  { "key": "p", "command": "filesExplorer.paste",
    "when": "filesExplorerFocus && !inputFocus" },
  { "key": "shift+y", "command": "copyRelativeFilePath",
    "when": "filesExplorerFocus && !inputFocus" },
  // v marks a node for a multi-file operation — the selection that y/x/p
  // then act on. nvim-tree calls this a bookmark and ships it on `m`;
  // VSCode has no bookmark concept, only a list selection.
  { "key": "v", "command": "list.toggleSelection",
    "when": "filesExplorerFocus && !inputFocus" },
  { "key": "shift+r", "command": "workbench.files.action.refreshFilesExplorer",
    "when": "filesExplorerFocus && !inputFocus" },

  // ══════════════════════════════════════════════════════════
  // Lists that DO have a text box (Quick Open, search) can't use
  // bare j/k. One rule everywhere: Ctrl+j / Ctrl+k. Already the
  // default in fzf and in Telescope, so it is the same motion in
  // all three.
  // ══════════════════════════════════════════════════════════
  { "key": "ctrl+j", "command": "workbench.action.quickOpenSelectNext",
    "when": "inQuickOpen" },
  { "key": "ctrl+k", "command": "workbench.action.quickOpenSelectPrevious",
    "when": "inQuickOpen" },
  { "key": "ctrl+j", "command": "selectNextSuggestion",
    "when": "suggestWidgetVisible" },
  { "key": "ctrl+k", "command": "selectPrevSuggestion",
    "when": "suggestWidgetVisible" },
  { "key": "ctrl+j", "command": "showNextParameterHint",
    "when": "parameterHintsVisible" },
  { "key": "ctrl+k", "command": "showPrevParameterHint",
    "when": "parameterHintsVisible" },

  // ══════════════════════════════════════════════════════════
  // Hand Ctrl back to fish.
  //
  // The obvious way — "-command" entries that delete VSCode's own binding —
  // does NOT work portably, because it has to name the exact command bound to
  // that key, and VSCode's defaults differ per platform: on Linux Ctrl+E is
  // quickOpen and Ctrl+W closes the window, on macOS neither is. Written
  // against macOS defaults, the removals silently miss on Linux.
  //
  // So instead of removing whatever VSCode has, we OVERRIDE the key and send
  // the control character to the shell ourselves. A user binding beats a
  // default one, "terminalFocus" keeps it out of the editor, and the byte is
  // the same byte on both machines — this block needs no per-OS variant.
  //
  // Codes are ASCII control characters: Ctrl+letter = letter - 64.
  // Deliberately NOT listed: Ctrl+C (must stay SIGINT / copy-selection) and
  // Ctrl+Z (SIGTSTP) — VSCode's defaults already do the right thing there.
  // ══════════════════════════════════════════════════════════
  { "key": "ctrl+a", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0001" }, "when": "terminalFocus" },   // beginning-of-line
  { "key": "ctrl+b", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0002" }, "when": "terminalFocus" },   // backward-char
  { "key": "ctrl+d", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0004" }, "when": "terminalFocus" },   // delete-char
  { "key": "ctrl+e", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0005" }, "when": "terminalFocus" },   // end-of-line
  { "key": "ctrl+f", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0006" }, "when": "terminalFocus" },   // accept autosuggestion
  { "key": "ctrl+g", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0007" }, "when": "terminalFocus" },   // fzf cd
  { "key": "ctrl+k", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u000b" }, "when": "terminalFocus" },   // kill to end of line
  { "key": "ctrl+l", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u000c" }, "when": "terminalFocus" },   // clear screen
  { "key": "ctrl+n", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u000e" }, "when": "terminalFocus" },   // history next
  { "key": "ctrl+p", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0010" }, "when": "terminalFocus" },   // history previous
  { "key": "ctrl+r", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0012" }, "when": "terminalFocus" },   // fzf history
  { "key": "ctrl+t", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0014" }, "when": "terminalFocus" },   // fzf files
  { "key": "ctrl+u", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0015" }, "when": "terminalFocus" },   // kill whole line
  { "key": "ctrl+v", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0016" }, "when": "terminalFocus" },   // paste from clipboard
  { "key": "ctrl+w", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0017" }, "when": "terminalFocus" },   // kill path component
  { "key": "ctrl+x", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0018" }, "when": "terminalFocus" },   // copy commandline
  { "key": "ctrl+y", "command": "workbench.action.terminal.sendSequence",
    "args": { "text": "\u0019" }, "when": "terminalFocus" }    // yank
]
