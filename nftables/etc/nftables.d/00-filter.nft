# firewall. inet family covers v4 + v6 in one table.
#
# Findings baked in (don't relearn the hard way):
#   - DHCP replies often arrive before conntrack can track them (src 0.0.0.0,
#     broadcast dst). They get classified INVALID -> must be allowed BEFORE
#     `ct state invalid drop`, not after.
#   - `pkttype host` excludes broadcast/multicast, so mDNS/SSDP fall through
#     to policy drop silently rather than getting reject'd (no reflection risk).
#   - `forward policy accept`: celestia runs Docker, which manages its own
#     forward rules via iptables-nft (separate ip/ip6 tables). A drop in this
#     inet table would ALSO drop Docker-forwarded packets, breaking containers.
#   - virbr0 allow is commented: uncomment when libvirt VMs need host
#     services (dnsmasq DNS, etc.). Off by default = smaller attack surface.

destroy table inet filter

table inet filter {
  chain input {
    type filter hook input priority filter; policy drop;

    # DHCP - must come before invalid-drop (see header)
    udp sport 67 udp dport 68 accept comment "dhcpv4 client"
    udp sport 547 udp dport 546 accept comment "dhcpv6 client"

    ct state invalid drop comment "drop invalid"
    ct state { established, related } accept comment "tracked"
    iif "lo" accept comment "loopback"
    # iif "virbr0" accept comment "libvirt bridge"   # uncomment if VMs need host access
    
    # comment to disable docker bridge
    iifname "docker0" accept comment "docker bridge"   

    meta l4proto { icmp, ipv6-icmp } accept comment "icmp"

    # tcp dport 22 accept comment "sshd"             # uncomment for inbound ssh

    meta pkttype host limit rate 5/second burst 5 packets counter reject with icmpx admin-prohibited
    counter comment "fell through to policy drop"
  }

  chain forward {
    type filter hook forward priority filter; policy accept;
    iifname "docker0" accept comment "accept forwarding to docker"
    ct state { established, related } accept comment "accept tracked traffic"
  }

  chain output {
    type filter hook output priority filter; policy accept;
  }
}

