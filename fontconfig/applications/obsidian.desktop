[Desktop Entry]
Name=Obsidian
# Override of /usr/share/applications/obsidian.desktop (pacman pkg). The only
# change vs upstream: FONTCONFIG_FILE points Obsidian at obsidian-fonts.conf so
# Terminess renders smooth (AA on) at Obsidian's arbitrary CSS sizes, while the
# bar/greeter keep the global pixel-crisp (AA off) config.
#
# XDG does not expand ~ or $HOME in Exec, and the repo lives at a different
# absolute path on each machine (laniakea /home/aru/dotfiles, celestia
# /home/segfault/celestia) — so go through sh -c and read $HOME at runtime.
# fontconfig/install.sh links obsidian-fonts.conf to the path below.
Exec=sh -c "exec env FONTCONFIG_FILE=\\$HOME/.config/fontconfig/obsidian-fonts.conf /usr/bin/obsidian \\"\\$@\\"" _ %U
Terminal=false
Type=Application
Icon=obsidian
StartupWMClass=obsidian
Comment=Obsidian
MimeType=x-scheme-handler/obsidian;
Categories=Office;
