[Desktop Entry]
Name=Obsidian
# Override of /usr/share/applications/obsidian.desktop (pacman pkg). The only
# change vs upstream: FONTCONFIG_FILE points Obsidian at fontconfig/obsidian-
# fonts.conf so Terminess renders smooth (AA on) at Obsidian's arbitrary CSS
# sizes, while the bar/greeter keep the global pixel-crisp (AA off) config.
# Path is absolute: XDG does not expand ~ in Exec.
Exec=env FONTCONFIG_FILE=/home/aru/dotfiles/fontconfig/obsidian-fonts.conf /usr/bin/obsidian %U
Terminal=false
Type=Application
Icon=obsidian
StartupWMClass=obsidian
Comment=Obsidian
MimeType=x-scheme-handler/obsidian;
Categories=Office;
